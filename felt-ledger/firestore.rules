rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone with the link can view the ledger.
      allow read: if true;
      // Only these signed-in Google accounts can log games, adjustments and edits.
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['EDITOR_EMAIL_HERE'];
    }
  }
}
